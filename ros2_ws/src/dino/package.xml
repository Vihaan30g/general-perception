<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>dino</name>
  <version>0.0.1</version>
  <description>Grounding DINO open-vocabulary detection stage of the perception pipeline</description>
  <maintainer email="vihaan30g@gmail.com">vihaan</maintainer>
  <license>Apache-2.0</license>

  <!-- Real ROS2 packages - these resolve via rosdep to apt packages -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>

  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>